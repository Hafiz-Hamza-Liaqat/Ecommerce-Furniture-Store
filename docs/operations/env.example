# AFH runtime environment template (no secrets — placeholders only)
# Copy to your secret manager / deployment platform. Do not commit real values.

# Profile: development | testing | staging | production
AFH_PROFILE=production

# Network
AFH_SERVICE_NAME=afh-api
AFH_HOST=0.0.0.0
AFH_PORT=8080
AFH_LOG_LEVEL=info
# Required in production — explicit SPA origin(s), comma-separated
AFH_CORS_ORIGIN=https://app.example.com
# Enable only behind a trusted reverse proxy that controls X-Forwarded-For.
AFH_TRUST_PROXY=false
# Keep API schema private in staging/production unless explicitly required.
AFH_EXPOSE_OPENAPI=false

# SQLite paths (mount persistent volumes in production)
AFH_DATABASE_PATH=./data/afh.sqlite
AFH_BROKER_DATABASE_PATH=./data/broker.sqlite

# SQL / resilience
AFH_SQL_BUSY_TIMEOUT_MS=5000
AFH_SQL_TRANSACTION_TIMEOUT_MS=30000
AFH_SQL_INTEGRITY_ON_STARTUP=true
AFH_STARTUP_RETRY_ATTEMPTS=3
AFH_STARTUP_RETRY_BACKOFF_MS=250,750,1500
AFH_SHUTDOWN_TIMEOUT_MS=30000

# Messaging
AFH_MESSAGING_CONSUMER_CONCURRENCY=4
AFH_MESSAGING_MAX_ATTEMPTS=8
AFH_MESSAGING_BACKOFF_MS=5000,30000,120000,600000,3600000
AFH_MESSAGING_POISON_THRESHOLD=1
AFH_MESSAGING_BATCH_SIZE=50
AFH_MESSAGING_CLAIM_LEASE_MS=60000

# Outbox / event bus
AFH_OUTBOX_BATCH_SIZE=50
AFH_OUTBOX_MAX_ATTEMPTS=8
AFH_EVENT_BUS_ENABLED=true

# Startup gates
AFH_REQUIRE_SECRETS=true
AFH_VALIDATE_ON_STARTUP=true

# Operational backup destination (scripts/backup-sqlite.sh)
AFH_BACKUP_DIR=./backups

# Secrets (≥32 chars for JWT signing key)
AFH_SECRET_JWT_SIGNING_KEY=REPLACE_WITH_32_PLUS_CHAR_SECRET
AFH_SECRET_JWT_SIGNING_KEY_PREVIOUS=
AFH_SECRET_DATABASE_URL=sqlite:./data/afh.sqlite
AFH_SECRET_BROKER_CREDENTIAL=REPLACE_BROKER_CREDENTIAL
AFH_SECRET_API_SECRET=REPLACE_API_SECRET
