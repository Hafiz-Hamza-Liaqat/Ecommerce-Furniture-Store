{
  "name": "@afh/api",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise API & transport foundation (Phase 7A)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
