{
  "name": "@afh/runtime-host",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise production readiness foundation (Phase 9A)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "afh-runtime": "./dist/bin/main.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "start": "node dist/bin/main.js",
    "verify": "node dist/bin/verify-release.js",
    "test": "npm run verify"
  },
  "dependencies": {
    "@afh/api": "0.1.0",
    "@afh/identity-providers": "0.1.0",
    "@afh/infrastructure": "0.1.0",
    "@afh/messaging-broker": "0.1.0",
    "@afh/persistence-sql": "0.1.0",
    "@afh/shared-kernel": "0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
